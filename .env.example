DJANGO_SECRET_KEY=change-me
# True only for local development
DJANGO_DEBUG=False
# Hostnames or IPs used to access the app
DJANGO_ALLOWED_HOSTS=<ip>,<domain>

#Default superuser credentials
DJANGO_SUPERUSER_USERNAME=admin
